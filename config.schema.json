{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Action": {
      "properties": {
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Input"
          },
          "type": "object"
        },
        "guards": {
          "$ref": "#/$defs/Guards"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "steps"
      ],
      "description": "Action is a reusable pipeline of steps, optionally exposed as a tool."
    },
    "Agent": {
      "properties": {
        "max_tools_per_message": {
          "type": "integer"
        },
        "timeout": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Agent bounds the tool loop inside a node (ADR 0008)."
    },
    "Bot": {
      "properties": {
        "graph": {
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/BotSettings"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "graph"
      ],
      "description": "Bot binds one WhatsApp account to a graph and its settings."
    },
    "BotSettings": {
      "properties": {
        "queue_delay": {
          "type": "integer"
        },
        "queue_jitter": {
          "type": "integer"
        },
        "simulate_typing": {
          "type": "boolean"
        },
        "typing_delay": {
          "type": "integer"
        },
        "read_receipts": {
          "type": "boolean"
        },
        "max_messages_per_minute": {
          "type": "integer"
        },
        "ignore_groups": {
          "type": "boolean"
        },
        "allowed_senders": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ignored_senders": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "BotSettings controls pacing and inbound filters (ADR 0011)."
    },
    "Config": {
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "description": "must be 1"
        },
        "address": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "log_level": {
          "type": "string"
        },
        "default_timeout": {
          "type": "integer"
        },
        "data_dir": {
          "type": "string"
        },
        "llm": {
          "$ref": "#/$defs/LLM"
        },
        "include": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scopes": {
          "additionalProperties": {
            "$ref": "#/$defs/Scope"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "version",
        "scopes"
      ],
      "description": "Config is the root document: global settings plus scopes (ADR 0016)."
    },
    "Cooldown": {
      "properties": {
        "duration": {
          "type": "integer"
        },
        "on_blocked": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "duration"
      ],
      "description": "Cooldown blocks the same sender for Duration seconds and runs OnBlocked."
    },
    "Edge": {
      "properties": {
        "intent": {
          "type": "string"
        },
        "triggers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "goto": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "goto"
      ],
      "description": "Edge is a transition."
    },
    "Graph": {
      "properties": {
        "root": {
          "type": "string"
        },
        "timeout": {
          "type": "integer"
        },
        "fallback": {
          "type": "string"
        },
        "routing": {
          "type": "string"
        },
        "initial_context": {
          "type": "object"
        },
        "nodes": {
          "additionalProperties": {
            "$ref": "#/$defs/Node"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "root",
        "nodes"
      ],
      "description": "Graph is a conversation state machine (ADR 0010, ADR 0015)."
    },
    "Guards": {
      "properties": {
        "cooldown": {
          "$ref": "#/$defs/Cooldown"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Guards limit how often an action runs."
    },
    "Input": {
      "properties": {
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": true,
        "description": {
          "type": "string"
        },
        "bind": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Input is a named, typed argument of a tool (ADR 0008)."
    },
    "LLM": {
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "api_key": {
          "$ref": "#/$defs/Secret"
        },
        "base_url": {
          "type": "string"
        },
        "routing": {
          "type": "string"
        },
        "realization": {
          "type": "string"
        },
        "agent": {
          "$ref": "#/$defs/Agent"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "LLM is the optional language-model integration (ADR 0003, ADR 0015)."
    },
    "Location": {
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "latitude",
        "longitude"
      ],
      "description": "Location is a map pin."
    },
    "Message": {
      "properties": {
        "body": {
          "$ref": "#/$defs/Text"
        },
        "intent": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Message is a reply: deterministic, LLM-realized, or anchored (ADR 0003)."
    },
    "Node": {
      "properties": {
        "goal": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "on_enter": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "on_exit": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "initial_context": {
          "type": "object"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Node is a state (ADR 0003, ADR 0008)."
    },
    "Request": {
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "body": {
          "type": "string"
        },
        "timeout": {
          "type": "integer"
        },
        "retry": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "description": "Request is an HTTP call whose result is addressable by Name."
    },
    "Scope": {
      "properties": {
        "actions": {
          "additionalProperties": {
            "$ref": "#/$defs/Action"
          },
          "type": "object"
        },
        "graphs": {
          "additionalProperties": {
            "$ref": "#/$defs/Graph"
          },
          "type": "object"
        },
        "bots": {
          "additionalProperties": {
            "$ref": "#/$defs/Bot"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Scope is an isolation namespace holding its own entities (ADR 0016)."
    },
    "Secret": {
      "type": "string"
    },
    "Step": {
      "properties": {
        "message": {
          "$ref": "#/$defs/Message"
        },
        "request": {
          "$ref": "#/$defs/Request"
        },
        "location": {
          "$ref": "#/$defs/Location"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Step is exactly one of message, request, or location."
    },
    "Text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    }
  }
}
