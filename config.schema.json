{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Action": {
      "properties": {
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Input"
          },
          "type": "object"
        },
        "guards": {
          "$ref": "#/$defs/Guards"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "steps"
      ],
      "description": "Action is a reusable pipeline of steps, optionally exposed as a tool."
    },
    "Bot": {
      "properties": {
        "graph": {
          "type": "string"
        },
        "llm": {
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/BotSettings"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "graph"
      ],
      "description": "Bot binds one WhatsApp account to a graph, an optional llm, and settings."
    },
    "BotSettings": {
      "properties": {
        "read_receipts": {
          "type": "boolean"
        },
        "read_receipt_delay": {
          "type": "integer"
        },
        "reply_delay": {
          "type": "integer"
        },
        "simulate_typing": {
          "type": "boolean"
        },
        "queue_delay": {
          "type": "integer"
        },
        "jitter": {
          "type": "integer"
        },
        "max_messages_per_minute": {
          "type": "integer"
        },
        "ignore_groups": {
          "type": "boolean"
        },
        "allowed_senders": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ignored_senders": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "history_sync": {
          "type": "boolean",
          "description": "HistorySync imports the messages WhatsApp delivers when the account is\nlinked. It defaults to true; false stores none of that backlog."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "BotSettings controls pacing, presence, filtering, and history import."
    },
    "Bounds": {
      "properties": {
        "max_tools_per_message": {
          "type": "integer"
        },
        "timeout": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Bounds limits how many tools a message may call and how long they may take."
    },
    "Config": {
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "description": "must be 1"
        },
        "address": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "log_level": {
          "type": "string"
        },
        "log_level_deps": {
          "type": "string"
        },
        "default_timeout": {
          "type": "integer"
        },
        "data_dir": {
          "type": "string"
        },
        "device_name": {
          "type": "string",
          "description": "DeviceName is the companion name WhatsApp shows in Linked devices. It is\nsent only when a bot registers a new pairing; an existing link keeps the\nname it was registered with. Empty uses the built-in default."
        },
        "include": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scopes": {
          "additionalProperties": {
            "$ref": "#/$defs/Scope"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "version",
        "scopes"
      ],
      "description": "Config is the root document: instance settings plus the scopes it runs."
    },
    "Cooldown": {
      "properties": {
        "duration": {
          "type": "integer"
        },
        "on_blocked": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "duration"
      ],
      "description": "Cooldown blocks the same sender for `duration` seconds, then runs the `on_blocked` steps."
    },
    "Edge": {
      "properties": {
        "intent": {
          "type": "string"
        },
        "triggers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "goto": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "goto"
      ],
      "description": "Edge is a transition."
    },
    "Graph": {
      "properties": {
        "root": {
          "type": "string"
        },
        "timeout": {
          "type": "integer"
        },
        "fallback": {
          "type": "string"
        },
        "routing": {
          "type": "string"
        },
        "initial_context": {
          "type": "object"
        },
        "nodes": {
          "additionalProperties": {
            "$ref": "#/$defs/Node"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "root",
        "nodes"
      ],
      "description": "Graph is a conversation state machine."
    },
    "Guards": {
      "properties": {
        "cooldown": {
          "$ref": "#/$defs/Cooldown"
        },
        "rate_limit": {
          "$ref": "#/$defs/RateLimit"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Guards limit how often an action runs."
    },
    "Input": {
      "properties": {
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": true,
        "description": {
          "type": "string"
        },
        "bind": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Input is a named, typed argument of a tool."
    },
    "LLM": {
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "api_key": {
          "$ref": "#/$defs/Secret"
        },
        "base_url": {
          "type": "string"
        },
        "routing": {
          "type": "string"
        },
        "realization": {
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/Bounds"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "provider",
        "model"
      ],
      "description": "LLM is a named, scoped model profile a bot can reference."
    },
    "Location": {
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "latitude",
        "longitude"
      ],
      "description": "Location is a map pin."
    },
    "Message": {
      "properties": {
        "body": {
          "$ref": "#/$defs/Text"
        },
        "intent": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Message is a reply: a fixed body, an LLM-realized reply, or both."
    },
    "Node": {
      "properties": {
        "goal": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "on_enter": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "on_exit": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "initial_context": {
          "type": "object"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Node is one state of a graph."
    },
    "RateLimit": {
      "properties": {
        "limit": {
          "type": "integer"
        },
        "window": {
          "type": "integer"
        },
        "on_blocked": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "limit",
        "window"
      ],
      "description": "RateLimit allows at most `limit` runs per sender in `window` seconds and runs the `on_blocked` steps when the sender exceeds it."
    },
    "Request": {
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/Secret"
          },
          "type": "object"
        },
        "body": {
          "type": "string"
        },
        "timeout": {
          "type": "integer"
        },
        "retry": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "description": "Request is an HTTP call whose result is addressable by its `name`."
    },
    "Scope": {
      "properties": {
        "llms": {
          "additionalProperties": {
            "$ref": "#/$defs/LLM"
          },
          "type": "object"
        },
        "actions": {
          "additionalProperties": {
            "$ref": "#/$defs/Action"
          },
          "type": "object"
        },
        "graphs": {
          "additionalProperties": {
            "$ref": "#/$defs/Graph"
          },
          "type": "object"
        },
        "bots": {
          "additionalProperties": {
            "$ref": "#/$defs/Bot"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Scope is an isolation namespace holding its own entities."
    },
    "Secret": {
      "type": "string"
    },
    "Step": {
      "properties": {
        "message": {
          "$ref": "#/$defs/Message"
        },
        "request": {
          "$ref": "#/$defs/Request"
        },
        "location": {
          "$ref": "#/$defs/Location"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Step is exactly one of message, request, or location."
    },
    "Text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    }
  }
}
