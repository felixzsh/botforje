{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "description": "Action is a reusable pipeline of steps, optionally exposed as a tool.",
      "properties": {
        "display_name": {
          "description": "DisplayName is an optional label for people-facing interfaces.",
          "type": "string"
        },
        "guards": {
          "$ref": "#/$defs/Guards"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Input"
          },
          "type": "object"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "type": "object"
    },
    "Bot": {
      "additionalProperties": false,
      "description": "Bot binds one channel account to a graph, an optional llm, and settings.",
      "properties": {
        "channel": {
          "$ref": "#/$defs/Channel",
          "description": "Channel selects the installed implementation this bot runs on; absent\nmeans the documented WhatsApp native default."
        },
        "display_name": {
          "description": "DisplayName is an optional label for people-facing interfaces.",
          "type": "string"
        },
        "graph": {
          "type": "string"
        },
        "llm": {
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/BotSettings"
        }
      },
      "required": [
        "graph"
      ],
      "type": "object"
    },
    "BotSettings": {
      "additionalProperties": false,
      "description": "BotSettings controls the settings every channel shares.",
      "properties": {
        "allowed_peers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "external_reply_pause": {
          "description": "ExternalReplyPause is the milliseconds one chat stays handed to a human\nafter a message leaves the account without Botflota sending it. It is a\nfleet policy, so it stays shared; observing the external reply at all is\nthe channel's declared capability and a channel without it refuses the\nsetting.",
          "type": "integer"
        },
        "history_sync": {},
        "ignored_peers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "import_contacts": {},
        "jitter": {
          "type": "integer"
        },
        "max_messages_per_minute": {
          "type": "integer"
        },
        "queue_delay": {
          "type": "integer"
        },
        "read_receipt_delay": {},
        "read_receipts": {},
        "reply_delay": {},
        "simulate_typing": {}
      },
      "type": "object"
    },
    "Bounds": {
      "additionalProperties": false,
      "description": "Bounds limits how many tools a message may call and how long they may take.",
      "properties": {
        "max_tools_per_message": {
          "type": "integer"
        },
        "timeout": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Channel": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "native"
            },
            "options": {
              "additionalProperties": false,
              "properties": {
                "external_reply_pause": {
                  "type": "integer"
                },
                "history_sync": {
                  "type": "boolean"
                },
                "import_contacts": {
                  "type": "boolean"
                },
                "read_receipt_delay": {
                  "type": "integer"
                },
                "read_receipts": {
                  "type": "boolean"
                },
                "reply_delay": {
                  "type": "integer"
                },
                "simulate_typing": {
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "provider": {
              "const": "whatsapp"
            }
          },
          "required": [
            "provider",
            "mode"
          ],
          "type": "object"
        }
      ]
    },
    "ChannelOptions": {
      "type": "object"
    },
    "Config": {
      "additionalProperties": false,
      "description": "Config is the root document: instance settings plus the scopes it runs.",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "data_dir": {
          "type": "string"
        },
        "default_timeout": {
          "type": "integer"
        },
        "device_name": {
          "description": "DeviceName is the companion name WhatsApp shows in Linked devices. It is\nsent only when a bot registers a new pairing; an existing link keeps the\nname it was registered with. Empty uses the built-in default.",
          "type": "string"
        },
        "exclusive_scopes": {
          "description": "ExclusiveScopes makes a scope grant exclusive: minting an access token\nthen refuses a scope another active token already holds, and startup\nrefuses to run while a scope is already granted to several active\ntokens, so a scope belongs to at most one active token. The default\nfalse lets any number of tokens share a scope; the owner token covers\nevery scope either way. Changing it requires a restart.",
          "type": "boolean"
        },
        "include": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "log_level": {
          "type": "string"
        },
        "log_level_deps": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "rate_limit": {
          "$ref": "#/$defs/RateLimitSettings",
          "description": "RateLimit bounds the API per fixed minute; an omitted block uses the\nbuilt-in budgets, and changing it requires a restart."
        },
        "scopes": {
          "additionalProperties": {
            "$ref": "#/$defs/Scope"
          },
          "type": "object"
        },
        "webhooks": {
          "description": "Webhooks are the outbound event deliveries this instance sends; see\nWebhookSettings.",
          "items": {
            "$ref": "#/$defs/WebhookSettings"
          },
          "type": "array"
        }
      },
      "required": [
        "scopes"
      ],
      "type": "object"
    },
    "Contact": {
      "additionalProperties": false,
      "description": "Contact shares one contact card: a display name plus reachability entries.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/ContactEntry"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "entries"
      ],
      "type": "object"
    },
    "ContactEntry": {
      "additionalProperties": false,
      "description": "ContactEntry is one reachability entry on a shared card.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "type": "object"
    },
    "Cooldown": {
      "additionalProperties": false,
      "description": "Cooldown blocks the same contact for `duration` seconds, then runs the `on_blocked` steps.",
      "properties": {
        "duration": {
          "type": "integer"
        },
        "on_blocked": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        }
      },
      "required": [
        "duration"
      ],
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "Edge is a transition.",
      "properties": {
        "goto": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "triggers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "goto"
      ],
      "type": "object"
    },
    "Graph": {
      "additionalProperties": false,
      "description": "Graph is a conversation state machine.",
      "properties": {
        "display_name": {
          "description": "DisplayName is an optional label for people-facing interfaces.",
          "type": "string"
        },
        "fallback": {
          "type": "string"
        },
        "initial_context": {
          "type": "object"
        },
        "nodes": {
          "additionalProperties": {
            "$ref": "#/$defs/Node"
          },
          "type": "object"
        },
        "root": {
          "type": "string"
        },
        "routing": {
          "type": "string"
        },
        "timeout": {
          "type": "integer"
        }
      },
      "required": [
        "root",
        "nodes"
      ],
      "type": "object"
    },
    "Guards": {
      "additionalProperties": false,
      "description": "Guards limit how often an action runs.",
      "properties": {
        "cooldown": {
          "$ref": "#/$defs/Cooldown"
        },
        "rate_limit": {
          "$ref": "#/$defs/RateLimit"
        }
      },
      "type": "object"
    },
    "Input": {
      "additionalProperties": false,
      "description": "Input is a named, typed argument of a tool.",
      "properties": {
        "bind": {
          "type": "string"
        },
        "default": true,
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "LLM": {
      "additionalProperties": false,
      "description": "LLM is a named, scoped model profile a bot can reference.",
      "properties": {
        "api_key": {
          "$ref": "#/$defs/Secret"
        },
        "base_url": {
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/Bounds"
        },
        "display_name": {
          "description": "DisplayName is an optional label for people-facing interfaces.",
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "realization": {
          "type": "string"
        },
        "routing": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "description": "Location is a map pin.",
      "properties": {
        "address": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "type": "object"
    },
    "Media": {
      "additionalProperties": false,
      "description": "Media declares an outbound attachment.",
      "properties": {
        "caption": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "description": "Message is a reply: a fixed body, an LLM-realized reply, or both.",
      "properties": {
        "body": {
          "$ref": "#/$defs/Text"
        },
        "intent": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "description": "Node is one state of a graph.",
      "properties": {
        "display_name": {
          "description": "DisplayName is an optional label for people-facing interfaces.",
          "type": "string"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "type": "array"
        },
        "goal": {
          "type": "string"
        },
        "initial_context": {
          "type": "object"
        },
        "on_enter": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "on_exit": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "policy": {
          "type": "string"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Poll": {
      "additionalProperties": false,
      "description": "Poll creates a poll.",
      "properties": {
        "options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "question": {
          "type": "string"
        },
        "selectable": {
          "type": "integer"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "options"
      ],
      "type": "object"
    },
    "RateLimit": {
      "additionalProperties": false,
      "description": "RateLimit allows at most `limit` runs per contact in `window` seconds and runs the `on_blocked` steps when the contact exceeds it.",
      "properties": {
        "limit": {
          "type": "integer"
        },
        "on_blocked": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "window": {
          "type": "integer"
        }
      },
      "required": [
        "limit",
        "window"
      ],
      "type": "object"
    },
    "RateLimitSettings": {
      "additionalProperties": false,
      "description": "RateLimitSettings are the API's per-minute request budgets.",
      "properties": {
        "credential_per_minute": {
          "type": "integer"
        },
        "failed_per_minute": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "description": "Request is an HTTP call whose result is addressable by its `name`.",
      "properties": {
        "body": {
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/Secret"
          },
          "type": "object"
        },
        "method": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "retry": {
          "type": "integer"
        },
        "timeout": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "Scope is an isolation namespace holding its own entities.",
      "properties": {
        "actions": {
          "additionalProperties": {
            "$ref": "#/$defs/Action"
          },
          "type": "object"
        },
        "bots": {
          "additionalProperties": {
            "$ref": "#/$defs/Bot"
          },
          "type": "object"
        },
        "display_name": {
          "description": "DisplayName is an optional label for people-facing interfaces.",
          "type": "string"
        },
        "graphs": {
          "additionalProperties": {
            "$ref": "#/$defs/Graph"
          },
          "type": "object"
        },
        "llms": {
          "additionalProperties": {
            "$ref": "#/$defs/LLM"
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "Secret": {
      "type": "string"
    },
    "Step": {
      "additionalProperties": false,
      "description": "Step is exactly one of message, request, location, media, contact, or poll.",
      "properties": {
        "contact": {
          "$ref": "#/$defs/Contact"
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "media": {
          "$ref": "#/$defs/Media"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "poll": {
          "$ref": "#/$defs/Poll"
        },
        "request": {
          "$ref": "#/$defs/Request"
        }
      },
      "type": "object"
    },
    "Text": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    },
    "WebhookSettings": {
      "additionalProperties": false,
      "description": "WebhookSettings is one instance-level webhook target: where deliveries go, the secret their bodies are signed with, and the events it subscribes to.",
      "properties": {
        "events": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "secret": {
          "$ref": "#/$defs/Secret"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "secret",
        "events"
      ],
      "type": "object"
    }
  },
  "$ref": "#/$defs/Config",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
